[Unit]
Description=Yandex Music Web Controller
After=network-online.target mpd.service
Wants=network-online.target mpd.service

[Service]
Type=simple
User=player
WorkingDirectory=/home/player/ymusic
ExecStart=/usr/bin/python3 -u /home/player/ymusic/ym_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
